# ---------------------------------------------------------------------------
# NEXUS Phone Agent — server configuration template
#
# Copy to ".env" for local development. Never commit a filled in ".env".
# On a hosting provider, set these as environment variables / secrets instead.
# Every value below is a placeholder: nothing here is a working credential.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public origin of the server, used to build the wss:// URL shown to the app.
# Example: https://nexus-control.onrender.com
PUBLIC_BASE_URL=
WS_PATH=/api/v1/device

# Behind a reverse proxy or PaaS router? Keep true so req.ip is the client IP.
TRUST_PROXY=true

LOG_LEVEL=info          # debug | info | warn | error | silent
LOG_FORMAT=json         # json | pretty

# One or more owner bearer tokens (comma separated). Generate with:
#   openssl rand -hex 32
# REQUIRED in production. Used as: Authorization: Bearer <token>
OWNER_API_TOKENS=

# ------------------------------- AI provider --------------------------------
# openai            : official OpenAI API
# openai_compatible : any endpoint that speaks the OpenAI Chat Completions API
#                     (set OPENAI_BASE_URL as well)
# mock              : offline planner for tests, refused in production
# none              : no provider; /readyz reports degraded
AI_PROVIDER=openai
OPENAI_API_KEY=
# Verified model identifiers are listed in the OpenAI changelog:
# https://developers.openai.com/api/docs/changelog
OPENAI_MODEL=gpt-6.1-sol
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional reasoning budget: low | medium | high | xhigh | max
# OPENAI_REASONING_EFFORT=low
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# --------------------------------- Budgets ----------------------------------
MAX_ACTIONS_PER_TASK=12
MAX_TASK_DURATION_SECONDS=90
MAX_ACTION_TIMEOUT_MS=20000
MAX_ACTION_RETRIES=2
MAX_PLANNING_ITERATIONS=3
MAX_PENDING_TASKS_PER_DEVICE=3
TASK_CREATE_RATE_PER_MINUTE=20
TASK_HISTORY_RETENTION_DAYS=30
APPROVAL_TIMEOUT_SECONDS=900

# ------------------------------- Connection ---------------------------------
MAX_MESSAGE_BYTES=32768
MAX_WS_CONNECTIONS=50
HEARTBEAT_INTERVAL_MS=20000
HEARTBEAT_TIMEOUT_MS=60000
AUTH_TIMEOUT_MS=15000
WS_MESSAGE_RATE_PER_MINUTE=240

# --------------------------------- Pairing ----------------------------------
PAIRING_CODE_TTL_SECONDS=300
PAIRING_MAX_ATTEMPTS=5
PAIRING_FAILURE_WINDOW_SECONDS=300
PAIRING_CREATE_RATE_PER_MINUTE=10
PAIRING_COMPLETE_RATE_PER_MINUTE=20

# --------------------------- Sensitive action policy ------------------------
# approval : park the task until the owner approves it (default)
# deny     : refuse sensitive actions outright
POLICY_SENSITIVE_MODE=approval

# --------------------------------- Storage ----------------------------------
# json   : atomic JSON snapshots on disk (default, no native modules)
# sqlite : Node.js built-in node:sqlite (Node >= 22.5)
# memory : nothing is persisted (tests)
STORAGE_DRIVER=json
STORAGE_PATH=./data
DATABASE_URL=./data/nexus.db

# --------------------------------- Bot --------------------------------------
# Telegram is the supported adapter. Create a bot with @BotFather and put your
# own numeric Telegram user id in TELEGRAM_ALLOWED_USER_IDS.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT_SECONDS=25
