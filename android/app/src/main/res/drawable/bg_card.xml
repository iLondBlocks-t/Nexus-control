<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle glass-like surface: white card, hairline border, soft shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A000000" />
            <corners android:radius="14dp" />
            <padding
                android:bottom="1dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nexus_white" />
            <stroke
                android:width="1dp"
                android:color="@color/nexus_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
