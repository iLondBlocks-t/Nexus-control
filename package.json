{
  "name": "nexus-phone-agent",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS Phone Agent — a personal, consent-based Android automation system: Node.js control server, AI planner, Telegram bot and native Android client.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "test": "node --test --test-concurrency=1 \"server/test/**/*.test.js\"",
    "lint": "node scripts/lint.js",
    "check:secrets": "node scripts/check-secrets.js",
    "check:config": "node scripts/check-config.js",
    "ai:doctor": "node scripts/ai-doctor.js",
    "android:check": "node scripts/check-android.js",
    "android:test": "cd android && ./gradlew :app:testDebugUnitTest",
    "android:apk": "cd android && ./gradlew :app:assembleDebug",
    "test:watch": "node --test --watch \"server/test/**/*.test.js\"",
    "verify": "node scripts/check-secrets.js && node scripts/lint.js && node scripts/check-android.js && npm test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
