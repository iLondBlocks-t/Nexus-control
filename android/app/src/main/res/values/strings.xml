    <!-- Accessibility service -->
    <string name="accessibility_service_label">NEXUS Phone Agent</string>
    <string name="accessibility_service_summary">Lets NEXUS perform the tasks you send from your own server.</string>
    <string name="accessibility_service_description">NEXUS reads the visible screen to find the elements you ask it to interact with, then taps, scrolls or types using Android\'s accessibility actions. It works only while you send a task, stops immediately when you press Stop, and never reads passwords, payment details or secure windows.</string>

