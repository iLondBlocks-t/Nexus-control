<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexus_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: product name plus the real connection state -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_full_name"
                style="@style/NexusText.Title" />

            <View
                android:id="@+id/main_status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_status_dot" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_label"
                style="@style/NexusText.Section" />

            <TextView
                android:id="@+id/main_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/state_not_configured"
                style="@style/NexusText.Body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/server_label"
                style="@style/NexusText.Section" />

            <TextView
                android:id="@+id/main_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/value_not_set"
                style="@style/NexusText.Mono" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/device_label"
                style="@style/NexusText.Section" />

            <TextView
                android:id="@+id/main_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/value_not_set"
                style="@style/NexusText.Mono" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/accessibility_label"
                style="@style/NexusText.Section" />

            <TextView
                android:id="@+id/main_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/value_disabled"
                style="@style/NexusText.Body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/heartbeat_label"
                style="@style/NexusText.Section" />

            <TextView
                android:id="@+id/main_heartbeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/value_never"
                style="@style/NexusText.Body" />

            <Button
                android:id="@+id/main_accessibility_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/button_enable_accessibility"
                style="@style/NexusButton.Secondary" />
        </LinearLayout>

        <!-- Active task and emergency stop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/active_task_label"
                style="@style/NexusText.Section" />

            <TextView
                android:id="@+id/main_active_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/value_none"
                style="@style/NexusText.Body" />

            <Button
                android:id="@+id/main_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="@string/button_stop"
                style="@style/NexusButton.Danger" />
        </LinearLayout>

        <!-- Manual task input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/main_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/task_instruction_hint"
                android:importantForAutofill="no"
                android:imeOptions="actionSend"
                android:singleLine="true"
                style="@style/NexusInput" />

            <Button
                android:id="@+id/main_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/button_submit_task"
                style="@style/NexusButton.Primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/main_new_task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:text="@string/button_new_task"
                    style="@style/NexusButton.Secondary" />

                <Button
                    android:id="@+id/main_settings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:text="@string/button_settings"
                    style="@style/NexusButton.Secondary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/history_label"
            style="@style/NexusText.Section" />

        <ListView
            android:id="@+id/main_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:divider="@color/nexus_border"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/main_history_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/history_empty"
            style="@style/NexusText.Body" />
    </LinearLayout>
</ScrollView>
