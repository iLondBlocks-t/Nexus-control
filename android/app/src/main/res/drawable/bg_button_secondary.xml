<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nexus_surface_alt" />
            <stroke
                android:width="1dp"
                android:color="@color/nexus_charcoal" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nexus_white" />
            <stroke
                android:width="1dp"
                android:color="@color/nexus_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
